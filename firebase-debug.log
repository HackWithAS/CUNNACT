[debug] [2026-09-22T15:27:48.144Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/cunnact/rulesets {"name":"projects/cunnact/rulesets/a941513b-00e0-46c0-8968-7affaeaffb53","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }\n    function requestIdFor(a, b) { return a < b ? a + \"_\" + b : b + \"_\" + a; }\n    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }\n    function userExists(uid) { return exists(userPath(uid)); }\n    function blockPath(blockerUid, otherUid) {\n      return /databases/$(database)/documents/users/$(blockerUid)/blockedUsers/$(otherUid);\n    }\n    function blockedBy(blockerUid, otherUid) { return exists(blockPath(blockerUid, otherUid)); }\n    function canContact(otherUid) {\n      return userExists(request.auth.uid) && userExists(otherUid)\n        && !blockedBy(request.auth.uid, otherUid) && !blockedBy(otherUid, request.auth.uid);\n    }\n    function acceptedRequest(otherUid) {\n      let ref = /databases/$(database)/documents/messageRequests/$(requestIdFor(request.auth.uid, otherUid));\n      return exists(ref) && get(ref).data.status == \"accepted\";\n    }\n    function isMember(conversationId) {\n      return signedIn() && exists(/databases/$(database)/documents/conversations/$(conversationId))\n        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;\n    }\n\n    match /users/{uid} {\n      // Kept readable to preserve the current chat/request directory architecture.\n      // Private fields should not be copied into publicProfiles.\n      allow read: if signedIn();\n      allow create: if isSelf(uid);\n      allow update: if isSelf(uid);\n      allow delete: if false;\n    }\n\n    match /publicProfiles/{uid} {\n      allow read: if true;\n      allow create: if isSelf(uid) && request.resource.data.uid == uid\n        && request.resource.data.keys().hasOnly([\"uid\",\"username\",\"usernameLower\",\"displayName\",\"photoURL\",\"bio\",\"updatedAt\"]);\n      allow update: if isSelf(uid) && request.resource.data.uid == uid\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          \"uid\",\"username\",\"usernameLower\",\"displayName\",\"photoURL\",\"bio\",\"updatedAt\"\n        ]);\n      allow delete: if isSelf(uid);\n    }\n\n    match /usernames/{usernameLower} {\n      allow read: if true;\n      allow create: if signedIn()\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.keys().hasOnly([\"uid\",\"createdAt\"]);\n      allow update: if signedIn()\n        && resource.data.uid == request.auth.uid\n        && request.resource.data.uid == request.auth.uid\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"uid\",\"createdAt\"]);\n      allow delete: if signedIn() && resource.data.uid == request.auth.uid;\n    }\n\n    match /users/{uid}/blockedUsers/{blockedUid} {\n      allow read: if isSelf(uid);\n      allow create: if isSelf(uid) && blockedUid != uid;\n      allow update: if false;\n      allow delete: if isSelf(uid);\n    }\n\n    match /messageRequests/{requestId} {\n      allow read: if signedIn()\n        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);\n      allow create: if signedIn()\n        && request.auth.uid == request.resource.data.senderId\n        && request.resource.data.senderId != request.resource.data.receiverId\n        && request.resource.data.status == \"pending\"\n        && canContact(request.resource.data.receiverId);\n      allow update: if signedIn()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"status\", \"updatedAt\"])\n        && (\n          (request.auth.uid == resource.data.receiverId\n            && resource.data.status == \"pending\"\n            && request.resource.data.status in [\"accepted\", \"declined\"]\n            && canContact(resource.data.senderId))\n          ||\n          (request.auth.uid == resource.data.senderId\n            && resource.data.status == \"declined\"\n            && request.resource.data.status == \"pending\"\n            && canContact(resource.data.receiverId))\n        );\n      allow delete: if false;\n    }\n\n    match /conversations/{conversationId} {\n      allow create: if signedIn()\n        && request.resource.data.members is list\n        && request.resource.data.members.size() == 2\n        && request.resource.data.members[0] != request.resource.data.members[1]\n        && request.auth.uid in request.resource.data.members\n        && (\n          request.resource.data.members[0] == request.auth.uid\n            ? acceptedRequest(request.resource.data.members[1])\n            : acceptedRequest(request.resource.data.members[0])\n        )\n        && canContact(\n          request.resource.data.members[0] == request.auth.uid\n            ? request.resource.data.members[1]\n            : request.resource.data.members[0]\n        );\n      allow read: if signedIn() && request.auth.uid in resource.data.members;\n      allow update: if signedIn()\n        && request.auth.uid in resource.data.members\n        && request.resource.data.members == resource.data.members\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          \"lastMessage\",\"lastMessageType\",\"lastMessageSenderId\",\"lastMessageTime\",\"unread\",\"typing\"\n        ])\n        && (\n          !(\"typing\" in request.resource.data)\n          || request.resource.data.get(\"typing\", {}).diff(resource.data.get(\"typing\", {})).affectedKeys().hasOnly([request.auth.uid])\n        );\n      allow delete: if false;\n\n      match /messages/{messageId} {\n        allow read: if isMember(conversationId);\n        allow create: if isMember(conversationId)\n          && request.resource.data.senderId == request.auth.uid\n          && request.resource.data.receiverId != request.auth.uid\n          && request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members\n          && request.resource.data.type in [\"text\",\"image\"]\n          && request.resource.data.createdAt != null\n          && canContact(request.resource.data.receiverId);\n\n        allow update: if isMember(conversationId) && (\n          (\n            request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"savedBy\"])\n            && request.resource.data.get(\"savedBy\", []) is list\n            && resource.data.get(\"savedBy\", []) is list\n            && (\n              (!(request.auth.uid in resource.data.get(\"savedBy\", []))\n                && request.auth.uid in request.resource.data.get(\"savedBy\", [])\n                && request.resource.data.get(\"savedBy\", []).size() == resource.data.get(\"savedBy\", []).size() + 1\n                && request.resource.data.get(\"savedBy\", []).hasAll(resource.data.get(\"savedBy\", [])))\n              ||\n              (request.auth.uid in resource.data.get(\"savedBy\", [])\n                && !(request.auth.uid in request.resource.data.get(\"savedBy\", []))\n                && resource.data.get(\"savedBy\", []).size() == request.resource.data.get(\"savedBy\", []).size() + 1\n                && resource.data.get(\"savedBy\", []).hasAll(request.resource.data.get(\"savedBy\", [])))\n            )\n          )\n          ||\n          (\n            request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"readBy\"])\n            && request.auth.uid == resource.data.receiverId\n            && request.resource.data.get(\"readBy\", {}) is map\n            && resource.data.get(\"readBy\", {}) is map\n            && request.resource.data.get(\"readBy\", {}).diff(resource.data.get(\"readBy\", {})).affectedKeys().hasOnly([request.auth.uid])\n          )\n          ||\n          (\n            request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"deletedFor\"])\n            && request.resource.data.get(\"deletedFor\", []) is list\n            && resource.data.get(\"deletedFor\", []) is list\n            && !(request.auth.uid in resource.data.get(\"deletedFor\", []))\n            && request.auth.uid in request.resource.data.get(\"deletedFor\", [])\n            && request.resource.data.get(\"deletedFor\", []).size() == resource.data.get(\"deletedFor\", []).size() + 1\n            && request.resource.data.get(\"deletedFor\", []).hasAll(resource.data.get(\"deletedFor\", []))\n          )\n          ||\n          (\n            request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"reactions\"])\n            && request.resource.data.get(\"reactions\", {}) is map\n            && resource.data.get(\"reactions\", {}) is map\n            && request.resource.data.get(\"reactions\", {}).diff(resource.data.get(\"reactions\", {})).affectedKeys().hasOnly([request.auth.uid])\n          )\n        );\n        allow delete: if isMember(conversationId) && request.auth.uid == resource.data.senderId;\n      }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-22T15:27:47.500383Z","metadata":{"services":["cloud.firestore"]}}
