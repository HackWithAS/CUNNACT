rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function requestIdFor(a, b) { return a < b ? a + "_" + b : b + "_" + a; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function userExists(uid) { return exists(userPath(uid)); }
    function blockPath(blockerUid, otherUid) { return /databases/$(database)/documents/users/$(blockerUid)/blockedUsers/$(otherUid); }
    function blockedBy(blockerUid, otherUid) { return exists(blockPath(blockerUid, otherUid)); }
    function canContact(otherUid) {
      return signedIn() && userExists(request.auth.uid) && userExists(otherUid)
        && !blockedBy(request.auth.uid, otherUid) && !blockedBy(otherUid, request.auth.uid);
    }
    function acceptedRequest(otherUid) {
      let ref = /databases/$(database)/documents/messageRequests/$(requestIdFor(request.auth.uid, otherUid));
      return exists(ref) && get(ref).data.status == "accepted";
    }
    function isMember(conversationId) {
      return signedIn() && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }

    // Discoverable profile + presence fields only. Private preferences live in userSettings.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;

      match /blockedUsers/{blockedUid} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && blockedUid != uid;
        allow update: if false;
        allow delete: if isSelf(uid);
      }
    }

    match /userSettings/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if true;
      allow create: if isSelf(uid) && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(["uid","username","usernameLower","displayName","photoURL","bio","updatedAt"]);
      allow update: if isSelf(uid) && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid","username","usernameLower","displayName","photoURL","bio","updatedAt"
        ]);
      allow delete: if isSelf(uid);
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid","createdAt"]);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid","createdAt"]);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /messageRequests/{requestId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.status == "pending"
        && canContact(request.resource.data.receiverId);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && (
          (request.auth.uid == resource.data.receiverId
            && resource.data.status == "pending"
            && request.resource.data.status in ["accepted", "declined"]
            && canContact(resource.data.senderId))
          ||
          (request.auth.uid == resource.data.senderId
            && resource.data.status == "declined"
            && request.resource.data.status == "pending"
            && canContact(resource.data.receiverId))
        );
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && (
          request.resource.data.members[0] == request.auth.uid
            ? acceptedRequest(request.resource.data.members[1])
            : acceptedRequest(request.resource.data.members[0])
        )
        && canContact(
          request.resource.data.members[0] == request.auth.uid
            ? request.resource.data.members[1]
            : request.resource.data.members[0]
        );
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage","lastMessageType","lastMessageSenderId","lastMessageId","lastMessageTime","unread",
          "pinned","hiddenFor"
        ]);
      allow delete: if false;

      match /typing/{uid} {
        allow read: if isMember(conversationId);
        allow create, update: if isMember(conversationId) && isSelf(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.typing == true;
        allow delete: if isMember(conversationId) && isSelf(uid);
      }

      match /messages/{messageId} {
        allow read: if isMember(conversationId);
        allow create: if isMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && request.resource.data.type in ["text","image"]
          && request.resource.data.createdAt != null
          && canContact(request.resource.data.receiverId);

        allow update: if isMember(conversationId) && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["savedBy"])
            && request.resource.data.get("savedBy", []) is list
            && resource.data.get("savedBy", []) is list
            && (
              (!(request.auth.uid in resource.data.get("savedBy", []))
                && request.auth.uid in request.resource.data.get("savedBy", [])
                && request.resource.data.get("savedBy", []).size() == resource.data.get("savedBy", []).size() + 1
                && request.resource.data.get("savedBy", []).hasAll(resource.data.get("savedBy", [])))
              ||
              (request.auth.uid in resource.data.get("savedBy", [])
                && !(request.auth.uid in request.resource.data.get("savedBy", []))
                && resource.data.get("savedBy", []).size() == request.resource.data.get("savedBy", []).size() + 1
                && resource.data.get("savedBy", []).hasAll(request.resource.data.get("savedBy", [])))
            )
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
            && request.auth.uid == resource.data.receiverId
            && request.resource.data.get("readBy", {}) is map
            && resource.data.get("readBy", {}) is map
            && request.resource.data.get("readBy", {}).diff(resource.data.get("readBy", {})).affectedKeys().hasOnly([request.auth.uid])
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deliveredBy"])
            && request.auth.uid == resource.data.receiverId
            && request.resource.data.get("deliveredBy", {}) is map
            && resource.data.get("deliveredBy", {}) is map
            && request.resource.data.get("deliveredBy", {}).diff(resource.data.get("deliveredBy", {})).affectedKeys().hasOnly([request.auth.uid])
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedFor"])
            && request.resource.data.get("deletedFor", []) is list
            && resource.data.get("deletedFor", []) is list
            && !(request.auth.uid in resource.data.get("deletedFor", []))
            && request.auth.uid in request.resource.data.get("deletedFor", [])
            && request.resource.data.get("deletedFor", []).size() == resource.data.get("deletedFor", []).size() + 1
            && request.resource.data.get("deletedFor", []).hasAll(resource.data.get("deletedFor", []))
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
            && request.resource.data.get("reactions", {}) is map
            && resource.data.get("reactions", {}) is map
            && request.resource.data.get("reactions", {}).diff(resource.data.get("reactions", {})).affectedKeys().hasOnly([request.auth.uid])
          )
        );
        allow delete: if isMember(conversationId) && request.auth.uid == resource.data.senderId;
      }
    }

    match /users/{uid}/savedMessages/{messageId} {
      allow read, create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }
  }
}
