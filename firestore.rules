rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function requestIdFor(a, b) { return a < b ? a + "_" + b : b + "_" + a; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function userExists(uid) { return exists(userPath(uid)); }
    function publicProfilePath(uid) { return /databases/$(database)/documents/publicProfiles/$(uid); }
    function accountExists(uid) { return userExists(uid) || exists(publicProfilePath(uid)); }
    function blockPath(blockerUid, otherUid) { return /databases/$(database)/documents/users/$(blockerUid)/blockedUsers/$(otherUid); }
    function blockedBy(blockerUid, otherUid) { return exists(blockPath(blockerUid, otherUid)); }
    function canContact(otherUid) {
      return signedIn() && accountExists(request.auth.uid) && accountExists(otherUid)
        && !blockedBy(request.auth.uid, otherUid) && !blockedBy(otherUid, request.auth.uid);
    }
    function acceptedRequest(otherUid) {
      let ref = /databases/$(database)/documents/messageRequests/$(requestIdFor(request.auth.uid, otherUid));
      return exists(ref) && get(ref).data.status == "accepted";
    }
    function isMember(conversationId) {
      return signedIn() && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }
    function storyVisible(storyId) {
      let s = get(/databases/$(database)/documents/stories/$(storyId)).data;
      return signedIn() && s.expiresAt > request.time && (
        s.ownerId == request.auth.uid
        || s.privacy == "public"
        || (s.privacy == "custom" && request.auth.uid in s.get("audienceIds", []))
        || (s.privacy == "closeFriends" && request.auth.uid in s.get("closeFriendsIds", []))
      );
    }

    // Discoverable profile + presence fields only. Private preferences live in userSettings.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;

      match /blockedUsers/{blockedUid} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && blockedUid != uid;
        allow update: if false;
        allow delete: if isSelf(uid);
      }
    }

    match /userSettings/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if (resource.data.get("profileVisibility", "public") == "public") || isSelf(uid);
      allow create: if isSelf(uid) && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(["uid","username","usernameLower","displayName","displayNameLower","profileVisibility","discoverable","photoURL","bio","updatedAt"]);
      allow update: if isSelf(uid) && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid","username","usernameLower","displayName","displayNameLower","profileVisibility","discoverable","photoURL","bio","updatedAt"
        ]);
      allow delete: if isSelf(uid);
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid","createdAt"]);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid","createdAt"]);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /messageRequests/{requestId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.status == "pending"
        && canContact(request.resource.data.receiverId);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && (
          (request.auth.uid == resource.data.receiverId
            && resource.data.status == "pending"
            && request.resource.data.status in ["accepted", "declined"]
            && canContact(resource.data.senderId))
          ||
          (request.auth.uid == resource.data.senderId
            && resource.data.status == "declined"
            && request.resource.data.status == "pending"
            && canContact(resource.data.receiverId))
        );
      // Sender may cancel a still-pending request. This removes the request
      // entirely so the receiver's pending-request listener updates immediately
      // and the sender can send a fresh request later.
      allow delete: if signedIn()
        && request.auth.uid == resource.data.senderId
        && resource.data.status == "pending";
    }

    // 24-hour stories. Discovery is query-compatible by privacy/audience.
    match /stories/{storyId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ["text","image","video","poll"]
        && request.resource.data.privacy in ["public","closeFriends","custom"]
        && request.resource.data.createdAt != null
        && request.resource.data.expiresAt != null;
      allow read: if storyVisible(storyId);
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text","mediaURL","sticker","linkUrl","linkHost","pollQuestion","pollOptions","pollVotes","pollCounts","expiresAt"]))
        ||
        (resource.data.type == "poll"
          && storyVisible(storyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pollVotes","pollCounts"]))
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /viewers/{uid} {
        allow read: if signedIn() && get(/databases/$(database)/documents/stories/$(storyId)).data.ownerId == request.auth.uid;
        allow create, update: if storyVisible(storyId) && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /replies/{replyId} {
        allow read: if storyVisible(storyId);
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && storyVisible(storyId);
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
      match /reactions/{uid} {
        allow read: if storyVisible(storyId);
        allow create, update: if storyVisible(storyId) && request.auth.uid == uid && request.resource.data.uid == uid
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 12;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Communities are umbrella spaces for CUNNACT groups and channels.
    match /communities/{communityId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.adminIds
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.privacy in ["public","private"];
      allow read: if signedIn() && (
        resource.data.privacy == "public" || request.auth.uid in resource.data.memberIds || request.auth.uid in resource.data.adminIds
      );
      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.adminIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name","nameLower","description","rules","privacy","adminIds","moderatorIds","memberIds","groupIds","channelIds","updatedAt"
          ])
        )
        ||
        (
          resource.data.privacy == "public"
          && !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.removeAll([request.auth.uid]) == resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds","updatedAt"])
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /joinRequests/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.adminIds);
        allow create: if signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/communities/$(communityId)).data.privacy == "private";
        allow update, delete: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.adminIds;
      }
    }

    // Public/private broadcast channels.
    match /channels/{channelId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.adminIds
        && request.auth.uid in request.resource.data.subscriberIds
        && request.resource.data.privacy in ["public","private"];
      allow read: if signedIn() && (
        resource.data.privacy == "public" || request.auth.uid in resource.data.adminIds || request.auth.uid in resource.data.subscriberIds
      );
      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.adminIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name","nameLower","description","privacy","adminIds","subscriberIds","communityId","updatedAt"
          ])
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["subscriberIds","updatedAt"])
          && (
            (!(request.auth.uid in resource.data.get("subscriberIds", [])) && request.auth.uid in request.resource.data.get("subscriberIds", []) && request.resource.data.get("subscriberIds", []).removeAll([request.auth.uid]) == resource.data.get("subscriberIds", []))
            ||
            (request.auth.uid in resource.data.get("subscriberIds", []) && !(request.auth.uid in request.resource.data.get("subscriberIds", [])) && resource.data.get("subscriberIds", []).removeAll([request.auth.uid]) == request.resource.data.get("subscriberIds", []))
          )
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /posts/{postId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/channels/$(channelId)).data.privacy == "public"
          || request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.adminIds
          || request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.subscriberIds
        );
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.adminIds
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.type in ["post","poll"]
          && request.resource.data.createdAt != null;
        allow update: if signedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.adminIds
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pollVotes","pollCounts"]) &&
            request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.subscriberIds
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactionCount"]) &&
            request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.subscriberIds
          )
        );
        allow delete: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.adminIds;

        match /comments/{commentId} {
          allow read: if signedIn() && (
            get(/databases/$(database)/documents/channels/$(channelId)).data.privacy == "public"
            || request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.adminIds
            || request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.subscriberIds
          );
          allow create: if signedIn()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && (
              get(/databases/$(database)/documents/channels/$(channelId)).data.privacy == "public"
              || request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.subscriberIds
              || request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.adminIds
            );
          allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
        }
        match /reactions/{uid} {
          allow read: if signedIn() && exists(/databases/$(database)/documents/channels/$(channelId)/posts/$(postId));
          allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    match /conversations/{conversationId} {
      allow create: if signedIn() && (
        (
          // Direct (1:1) chat — unchanged from before.
          (!("type" in request.resource.data) || request.resource.data.type == "direct")
          && request.resource.data.members is list
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] != request.resource.data.members[1]
          && request.auth.uid in request.resource.data.members
          && (
            request.resource.data.members[0] == request.auth.uid
              ? acceptedRequest(request.resource.data.members[1])
              : acceptedRequest(request.resource.data.members[0])
          )
          && canContact(
            request.resource.data.members[0] == request.auth.uid
              ? request.resource.data.members[1]
              : request.resource.data.members[0]
          )
        )
        ||
        (
          // Group chat — creator must be a member and an admin from the start.
          request.resource.data.type == "group"
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 3
          && request.resource.data.members.size() <= 50
          && request.auth.uid in request.resource.data.members
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.groupAdmins is list
          && request.auth.uid in request.resource.data.groupAdmins
          && request.resource.data.groupModerators is list
          && request.resource.data.groupRoles is map
          && request.resource.data.groupName is string
          && request.resource.data.groupName.size() > 0
          && request.resource.data.groupName.size() <= 60
          && request.resource.data.groupAdmins.hasAll(request.resource.data.groupModerators)
          && request.resource.data.members.hasAll(request.resource.data.groupModerators)
        )
      );
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members && (
        (
          // Preview / pin / hide bookkeeping — any member, any conversation type.
          request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "lastMessage","lastMessageType","lastMessageSenderId","lastMessageId","lastMessageTime","unread",
            "pinned","hiddenFor","disappearingSeconds"
          ])
        )
        ||
        (
          // Group admin renames the group or changes its photo.
          resource.data.type == "group"
          && request.auth.uid in resource.data.groupAdmins
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["groupName","groupPhotoURL"])
          && request.resource.data.groupName is string
          && request.resource.data.groupName.size() > 0
          && request.resource.data.groupName.size() <= 60
        )
        ||
        (
          // A valid invite can add the authenticated user directly when the group has disabled approval.
          resource.data.type == "group"
          && resource.data.get("joinApproval", true) == false
          && !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.removeAll([request.auth.uid]) == resource.data.members
          && request.resource.data.members.size() <= 50
          && request.resource.data.joinInviteToken is string
          && exists(/databases/$(database)/documents/conversations/$(conversationId)/invites/$(request.resource.data.joinInviteToken))
          && get(/databases/$(database)/documents/conversations/$(conversationId)/invites/$(request.resource.data.joinInviteToken)).data.active == true
          && get(/databases/$(database)/documents/conversations/$(conversationId)/invites/$(request.resource.data.joinInviteToken)).data.joinApproval == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members","joinInviteToken"])
        )
        ||
        (
          // Group admin updates identity, moderators, roles or join policy.
          resource.data.type == "group"
          && request.auth.uid in resource.data.groupAdmins
          && request.resource.data.members == resource.data.members
          && request.resource.data.groupAdmins is list
          && request.resource.data.groupModerators is list
          && request.resource.data.groupRoles is map
          && request.resource.data.groupAdmins.hasAll(request.resource.data.groupModerators)
          && request.resource.data.members.hasAll(request.resource.data.groupAdmins)
          && request.resource.data.members.hasAll(request.resource.data.groupModerators)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["groupName","groupPhotoURL","groupDescription","joinApproval","groupAdmins","groupModerators","groupRoles"])
        )
        ||
        (
          // Group admin adds and/or removes members (and keeps admins/unread/roles in sync).
          resource.data.type == "group"
          && request.auth.uid in resource.data.groupAdmins
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members","groupAdmins","groupModerators","groupRoles","unread"])
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 2
          && request.resource.data.members.size() <= 50
          && request.resource.data.groupAdmins is list
          && request.resource.data.groupAdmins.size() > 0
          && request.resource.data.groupModerators is list
          && request.resource.data.groupRoles is map
          && request.resource.data.members.hasAll(request.resource.data.groupAdmins)
          && request.resource.data.members.hasAll(request.resource.data.groupModerators) 
        )
        ||
        (
          // Any group member can leave on their own — removes only themselves.
          resource.data.type == "group"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members","groupAdmins","groupModerators","groupRoles"])
          && !(request.auth.uid in request.resource.data.members)
          && resource.data.members.removeAll([request.auth.uid]) == request.resource.data.members
          && resource.data.groupAdmins.removeAll([request.auth.uid]) == request.resource.data.groupAdmins
          && resource.data.get("groupModerators", []).removeAll([request.auth.uid]) == request.resource.data.groupModerators
        )
      );
      allow delete: if false;

      match /typing/{uid} {
        allow read: if isMember(conversationId);
        allow create, update: if isMember(conversationId) && isSelf(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.typing == true;
        allow delete: if isMember(conversationId) && isSelf(uid);
      }

      match /messages/{messageId} {
        allow read: if isMember(conversationId);
        allow create: if isMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ["text","image","audio","video","document","sticker","gif","contact","location","poll","event"]
          && request.resource.data.createdAt != null
          && (
            (
              // Direct message — unchanged single-receiver rule.
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.get("type","direct") == "direct"
              && request.resource.data.receiverId != request.auth.uid
              && request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
              && canContact(request.resource.data.receiverId)
            )
            ||
            (
              // Group message — no single receiver, just has to be a current member.
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == "group"
            )
          );


        allow update: if isMember(conversationId) && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["savedBy"])
            && request.resource.data.get("savedBy", []) is list
            && resource.data.get("savedBy", []) is list
            && (
              (!(request.auth.uid in resource.data.get("savedBy", []))
                && request.auth.uid in request.resource.data.get("savedBy", [])
                && request.resource.data.get("savedBy", []).size() == resource.data.get("savedBy", []).size() + 1
                && request.resource.data.get("savedBy", []).hasAll(resource.data.get("savedBy", [])))
              ||
              (request.auth.uid in resource.data.get("savedBy", [])
                && !(request.auth.uid in request.resource.data.get("savedBy", []))
                && resource.data.get("savedBy", []).size() == request.resource.data.get("savedBy", []).size() + 1
                && resource.data.get("savedBy", []).hasAll(request.resource.data.get("savedBy", [])))
            )
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
            && (
              (resource.data.get("receiverId", "") == request.auth.uid)
              || (get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == "group" && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members)
            )
            && request.resource.data.get("readBy", {}) is map
            && resource.data.get("readBy", {}) is map
            && request.resource.data.get("readBy", {}).diff(resource.data.get("readBy", {})).affectedKeys().hasOnly([request.auth.uid])
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deliveredBy"])
            && (
              (resource.data.get("receiverId", "") == request.auth.uid)
              || (get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == "group" && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members)
            )
            && request.resource.data.get("deliveredBy", {}) is map
            && resource.data.get("deliveredBy", {}) is map
            && request.resource.data.get("deliveredBy", {}).diff(resource.data.get("deliveredBy", {})).affectedKeys().hasOnly([request.auth.uid])
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedFor"])
            && request.resource.data.get("deletedFor", []) is list
            && resource.data.get("deletedFor", []) is list
            && !(request.auth.uid in resource.data.get("deletedFor", []))
            && request.auth.uid in request.resource.data.get("deletedFor", [])
            && request.resource.data.get("deletedFor", []).size() == resource.data.get("deletedFor", []).size() + 1
            && request.resource.data.get("deletedFor", []).hasAll(resource.data.get("deletedFor", []))
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pinnedBy"])
            && request.resource.data.get("pinnedBy", []) is list
            && resource.data.get("pinnedBy", []) is list
            && (
              (!(request.auth.uid in resource.data.get("pinnedBy", []))
                && request.auth.uid in request.resource.data.get("pinnedBy", [])
                && request.resource.data.get("pinnedBy", []).size() == resource.data.get("pinnedBy", []).size() + 1
                && request.resource.data.get("pinnedBy", []).hasAll(resource.data.get("pinnedBy", [])))
              ||
              (request.auth.uid in resource.data.get("pinnedBy", [])
                && !(request.auth.uid in request.resource.data.get("pinnedBy", []))
                && resource.data.get("pinnedBy", []).size() == request.resource.data.get("pinnedBy", []).size() + 1
                && resource.data.get("pinnedBy", []).hasAll(request.resource.data.get("pinnedBy", [])))
            )
          )
          ||
          (
            request.auth.uid == resource.data.senderId
            && resource.data.type == "text"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text","editedAt"])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 5000
            && request.resource.data.editedAt != null
            && (resource.data.get("createdAt") == null || request.time - resource.data.get("createdAt") < duration.value(15, "m"))
          )
          ||
          (
            // Sender may soft-delete their own message for everyone without removing the document.
            request.auth.uid == resource.data.senderId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedAt","deletedBy"])
            && request.resource.data.deletedAt != null
            && request.resource.data.deletedBy == request.auth.uid
          )
          ||
          (
            // Group admins/moderators may moderate any group message.
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == "group"
            && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.groupAdmins
              || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get("groupModerators", []))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedAt","deletedBy"])
            && request.resource.data.deletedAt != null
            && request.resource.data.deletedBy == request.auth.uid
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
            && request.resource.data.get("reactions", {}) is map
            && resource.data.get("reactions", {}) is map
            && request.resource.data.get("reactions", {}).diff(resource.data.get("reactions", {})).affectedKeys().hasOnly([request.auth.uid])
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedBy"])
            && request.resource.data.get("viewedBy", []) is list
            && resource.data.get("viewedBy", []) is list
            && !(request.auth.uid in resource.data.get("viewedBy", []))
            && request.auth.uid in request.resource.data.get("viewedBy", [])
            && request.resource.data.get("viewedBy", []).size() == resource.data.get("viewedBy", []).size() + 1
            && request.resource.data.get("viewedBy", []).hasAll(resource.data.get("viewedBy", []))
          )
          ||
          (
            resource.data.type == "poll"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pollVotes"])
            && request.resource.data.get("pollVotes", {}) is map
            && request.resource.data.get("pollVotes", {}).diff(resource.data.get("pollVotes", {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.get("pollVotes", {}).get(request.auth.uid, -1) >= 0
            && request.resource.data.get("pollVotes", {}).get(request.auth.uid, -1) < resource.data.get("pollOptions", []).size()
          )
        );
        allow delete: if isMember(conversationId) && request.auth.uid == resource.data.senderId;
      }

      match /invites/{token} {
        allow read: if signedIn();
        allow create: if signedIn()
          && isMember(conversationId)
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == "group"
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.groupAdmins
          && request.resource.data.token == token
          && request.resource.data.conversationId == conversationId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.active == true;
        allow update: if signedIn()
          && isMember(conversationId)
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.groupAdmins
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["active"]);
        allow delete: if signedIn()
          && isMember(conversationId)
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.groupAdmins;
      }

      match /joinRequests/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || (isMember(conversationId) && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.groupAdmins));
        allow create: if signedIn()
          && isSelf(uid)
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == "group"
          && request.resource.data.userId == uid
          && request.resource.data.inviteToken is string
          && exists(/databases/$(database)/documents/conversations/$(conversationId)/invites/$(request.resource.data.inviteToken))
          && get(/databases/$(database)/documents/conversations/$(conversationId)/invites/$(request.resource.data.inviteToken)).data.active == true;
        allow update: if signedIn()
          && isMember(conversationId)
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.groupAdmins
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","reviewedBy","reviewedAt"]);
        allow delete: if signedIn() && (isSelf(uid) || (isMember(conversationId) && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.groupAdmins));
      }

      match /reports/{reportId} {
        allow read: if signedIn() && isMember(conversationId) && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.groupAdmins || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get("groupModerators", []));
        allow create: if signedIn() && isMember(conversationId) && request.resource.data.reportedBy == request.auth.uid;
        allow update: if signedIn() && isMember(conversationId) && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.groupAdmins || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get("groupModerators", []));
        allow delete: if false;
      }

      match /calls/{callId} {
        allow read: if signedIn() && isMember(conversationId) && request.auth.uid in resource.data.participantIds;
        allow create: if signedIn()
          && isMember(conversationId)
          && request.resource.data.initiatorId == request.auth.uid
          && request.auth.uid in request.resource.data.participantIds
          && request.resource.data.participantIds is list
          && request.resource.data.participantIds.size() >= 2
          && request.resource.data.participantIds.size() <= 8
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.members.hasAll(request.resource.data.participantIds)
          && request.resource.data.type in ["direct","group"]
          && request.resource.data.callType in ["voice","video"];
        allow update: if signedIn()
          && isMember(conversationId)
          && request.auth.uid in resource.data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","joinedParticipantIds","activeParticipantIds","declinedBy","endedAt","endedBy","updatedAt","leftAt","callReaction","raisedHands"]);
        allow delete: if false;

        match /peers/{peerId} {
          allow read: if signedIn()
            && isMember(conversationId)
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId)).data.participantIds;
          allow create: if signedIn()
            && isMember(conversationId)
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId)).data.participantIds
            && (request.resource.data.from == request.auth.uid || request.resource.data.to == request.auth.uid);
          allow update: if signedIn()
            && isMember(conversationId)
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId)).data.participantIds
            && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || request.resource.data.from == request.auth.uid || request.resource.data.to == request.auth.uid);
          allow delete: if false;

          match /candidates/{candidateId} {
            allow read: if signedIn()
              && isMember(conversationId)
              && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId)).data.participantIds;
            allow create: if signedIn()
              && isMember(conversationId)
              && request.resource.data.senderId == request.auth.uid
              && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId)).data.participantIds;
            allow update, delete: if false;
          }
        }
      }

    }


    match /users/{uid}/devices/{sessionId} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && request.resource.data.sessionId == sessionId;
      allow update: if isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sessionId","label","platform","userAgent","active","lastSeen","createdAt","current"]);
      allow delete: if isSelf(uid);
    }

    match /securityEvents/{eventId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if signedIn() && resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid}/savedMessages/{messageId} {
      allow read, create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }
  }
}
