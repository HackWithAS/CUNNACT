rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function requestIdFor(a, b) {
      return a < b ? a + "_" + b : b + "_" + a;
    }

    function acceptedRequest(otherUid) {
      let requestRef = /databases/$(database)/documents/messageRequests/$(requestIdFor(request.auth.uid, otherUid));
      return exists(requestRef) && get(requestRef).data.status == "accepted";
    }

    function isMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }

    // ---------------- Users ----------------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    // ---------------- Message requests ----------------
    match /messageRequests/{requestId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.receiverId);

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.senderId != request.resource.data.receiverId
        && request.resource.data.status == "pending";

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && (
          (
            request.auth.uid == resource.data.receiverId
            && resource.data.status == "pending"
            && request.resource.data.status in ["accepted", "declined"]
          )
          ||
          (
            request.auth.uid == resource.data.senderId
            && resource.data.status == "declined"
            && request.resource.data.status == "pending"
          )
        );

      allow delete: if false;
    }

    // ---------------- Conversations ----------------
    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && (
          request.resource.data.members[0] == request.auth.uid
            ? acceptedRequest(request.resource.data.members[1])
            : acceptedRequest(request.resource.data.members[0])
        );

      allow read: if signedIn()
        && request.auth.uid in resource.data.members;

      // Members can update chat metadata, but cannot change who belongs to a chat.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage", "lastMessageType", "lastMessageSenderId", "lastMessageTime", "unread"
        ]);

      allow delete: if false;

      // ---------------- Messages ----------------
      match /messages/{messageId} {
        allow read: if isMember(conversationId);

        allow create: if isMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && request.resource.data.type in ["text", "image"]
          && request.resource.data.createdAt != null;

        allow update: if isMember(conversationId) && (
          // Save / unsave: exactly one user's saved state can change at a time.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["savedBy"])
            && request.resource.data.get("savedBy", []) is list
            && resource.data.get("savedBy", []) is list
            && (
              (
                !(request.auth.uid in resource.data.get("savedBy", []))
                && request.auth.uid in request.resource.data.get("savedBy", [])
                && request.resource.data.get("savedBy", []).size() == resource.data.get("savedBy", []).size() + 1
                && request.resource.data.get("savedBy", []).hasAll(resource.data.get("savedBy", []))
              )
              ||
              (
                request.auth.uid in resource.data.get("savedBy", [])
                && !(request.auth.uid in request.resource.data.get("savedBy", []))
                && resource.data.get("savedBy", []).size() == request.resource.data.get("savedBy", []).size() + 1
                && resource.data.get("savedBy", []).hasAll(request.resource.data.get("savedBy", []))
              )
            )
          )
          ||
          // Read receipt: only the receiver can set their own readBy field.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
            && request.auth.uid == resource.data.receiverId
            && request.resource.data.get("readBy", {}) is map
            && resource.data.get("readBy", {}) is map
            && request.resource.data.get("readBy", {}).diff(resource.data.get("readBy", {})).affectedKeys().hasOnly([request.auth.uid])
          )
          ||
          // Delete for me / retention: only append the current user's uid.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deletedFor"])
            && request.resource.data.get("deletedFor", []) is list
            && resource.data.get("deletedFor", []) is list
            && !(request.auth.uid in resource.data.get("deletedFor", []))
            && request.auth.uid in request.resource.data.get("deletedFor", [])
            && request.resource.data.get("deletedFor", []).size() == resource.data.get("deletedFor", []).size() + 1
            && request.resource.data.get("deletedFor", []).hasAll(resource.data.get("deletedFor", []))
          )
        );

        // Permanent delete is sender-only. "Delete for me" uses deletedFor above.
        allow delete: if isMember(conversationId)
          && request.auth.uid == resource.data.senderId;
      }
    }
  }
}
