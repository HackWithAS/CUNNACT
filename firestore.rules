rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMember(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }

    // Users collection
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    // Message requests collection
    match /messageRequests/{requestId} {
      allow read: if signedIn() 
        && (request.auth.uid == resource.data.senderId 
            || request.auth.uid == resource.data.receiverId);
      
      allow create: if signedIn() 
        && request.auth.uid == request.resource.data.senderId
        && request.resource.data.status == "pending";
      
      allow update: if signedIn()
        && request.auth.uid == resource.data.receiverId
        && request.resource.data.status in ["accepted", "declined"]
        && resource.data.status == "pending";
      
      allow delete: if false;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      
      allow read, update: if signedIn()
        && request.auth.uid in resource.data.members;
      
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isMember(conversationId);
        
        allow create: if isMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && request.resource.data.receiverId != request.auth.uid;
        
        // Allow update for saving messages
        allow update: if isMember(conversationId)
          && (
            // User can add/remove themselves from savedBy
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["savedBy", "savedAt"])
              && (request.resource.data.savedBy == null 
                  || request.auth.uid in request.resource.data.savedBy))
            // Sender can update readBy for marking as read
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
                && request.auth.uid == resource.data.receiverId)
          );
        
        // Only message sender can delete their own messages
        allow delete: if isMember(conversationId)
          && (request.auth.uid == resource.data.senderId 
              || request.auth.uid in resource.data.savedBy);
      }
    }
  }
}
